# FloodMesh coverage planner settings. Copy to .env.local for local
# development; on Vercel set the same names under Project > Settings >
# Environment Variables. Never commit real values.

# Neon Postgres connection string (set by the Vercel Neon integration). Leave
# unset locally to use the embedded PGlite database in ./.pglite.
# DATABASE_URL=postgresql://user:password@ep-example-123456.ap-south-1.aws.neon.tech/neondb?sslmode=require

# Password for /admin, where the cost sheet is edited. Use a long one.
ADMIN_PASSWORD=change-me

# Signs the admin login cookie: at least 32 random characters.
SESSION_SECRET=replace-with-a-long-random-string

# Only for a self-hosted server behind a reverse proxy that appends the
# client's address to X-Forwarded-For. Leave unset on Vercel.
# TRUST_PROXY=1
