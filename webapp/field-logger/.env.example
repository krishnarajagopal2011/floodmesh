# FloodMesh field logger settings. Copy to .env.local for local development;
# on Vercel set the same names under Project > Settings > Environment Variables.
# Never commit real values. Generate secrets with the commands in README.md.

# Neon Postgres connection string. Set automatically when you add Neon from
# the Vercel dashboard. Leave unset locally to use the embedded PGlite
# database in ./.pglite.
# DATABASE_URL=postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Fleet log key: 32-64 hex characters, the same value as the firmware build
# flag FM_LOG_KEY on every unit.
LOG_KEY=replace-with-64-hex-characters

# Signs login cookies: at least 32 random characters.
SESSION_SECRET=replace-with-a-long-random-string

# One passcode per unit, as JSON. Units without a passcode cannot log in.
UNIT_PASSCODES={"A":"change-me-a","B":"change-me-b","C":"change-me-c","D":"change-me-d","E":"change-me-e"}

# The test lead's passcode for the admin page and CSV exports.
ADMIN_PASSCODE=change-me-admin

# Call signs allowed to upload and log in (default A,B,C,D,E).
UNITS=A,B,C,D,E

# Time zone for "today" counts and the ts_local CSV column (default Asia/Kolkata).
# TIMEZONE=Asia/Kolkata

# Only for a self-hosted server behind a reverse proxy that appends the
# client's address to X-Forwarded-For. Leave unset on Vercel and for a plain
# `npm start` on the LAN (then all logins share one rate-limit bucket).
# TRUST_PROXY=1
